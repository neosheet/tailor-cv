# Copy this file to `.env.seed` (gitignored — never commit it) and fill in real
# values before running `npm run seed`.

# Same publishable client config the app itself uses (src/lib/supabase.ts). Safe to
# reuse the values from the app's own .env.local: this script never touches the
# secret/service-role key, it authenticates as a real user instead (see
# scripts/seed.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The one real Supabase Auth account this seeds data for, created once via the
# Supabase dashboard. The script signs in as this user so every insert satisfies
# RLS's `auth.uid() = user_id` the same way the app itself would.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
